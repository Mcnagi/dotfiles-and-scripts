#!/usr/bin/env bash
# extract — EXERCISE 1 (issue: "Exercise 1. extract").
# Unpack an archive into the current folder, choosing the tool from the file extension.
#
# Required behaviour — tests/extract.bats checks every line:
#   extract FILE           unpack FILE, then print "extracted FILE"; exit 0
#   extract -h | --help    print usage to stdout; exit 0
#   extract                (no arguments) usage to stderr; exit 2
#   extract missing.zip    "extract: no such file: missing.zip" to stderr; exit 1
#   extract notes.txt      "extract: unsupported file type: notes.txt" to stderr; exit 2
#
# Supported: .tar.gz  .tgz  .tar  .zip  .gz
#   .tar.gz/.tgz -> tar -xzf     .tar -> tar -xf     .zip -> unzip -q     .gz -> gunzip -k
#
# Hints:
#   - `case "$file" in *.tar.gz | *.tgz) ... ;; esac` matches on patterns; order matters,
#     because "x.tar.gz" also matches *.gz.
#   - Exit codes are a contract: 1 = it went wrong, 2 = you called it wrong.
#   - Start with `set -euo pipefail` (see install.sh for why).

echo "extract: not implemented yet — see LEARNING.md" >&2
exit 99
