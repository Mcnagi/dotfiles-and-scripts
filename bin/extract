#!/usr/bin/env bash
# extract — REFERENCE SOLUTION to exercise 1.
# Unpack an archive into the current folder, choosing the tool from the file extension.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: extract FILE

Unpack FILE into the current folder.
Supported: .tar.gz  .tgz  .tar  .zip  .gz

  -h, --help   show this help
EOF
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
esac

# Exit 2 = called wrong (usage), exit 1 = tried and failed. Scripts and CI rely on the difference.
if [[ $# -ne 1 ]]; then
  usage >&2
  exit 2
fi

file="$1"
if [[ ! -f "$file" ]]; then
  echo "extract: no such file: $file" >&2
  exit 1
fi

# Order matters: "x.tar.gz" also matches *.gz, so the longer pattern must come first.
case "$file" in
  *.tar.gz | *.tgz) tar -xzf "$file" ;;
  *.tar) tar -xf "$file" ;;
  *.zip) unzip -q "$file" ;;
  *.gz) gunzip -k "$file" ;;
  *)
    echo "extract: unsupported file type: $file" >&2
    exit 2
    ;;
esac

echo "extracted $file"
