#!/usr/bin/env bash
# new-exercise — REFERENCE SOLUTION to exercise 2.
# Create a well-named branch for an issue, starting from the base branch.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: new-exercise NUMBER SLUG

Create and switch to branch exercise/NUMBER-SLUG, starting from the base branch
(the remote's default branch, else main).

  NUMBER   the issue number, e.g. 7
  SLUG     a short lowercase-kebab name, e.g. merge-sort
  -h, --help   show this help
EOF
}

die() { echo "new-exercise: $*" >&2; exit 1; }
usage_error() { echo "new-exercise: $*" >&2; exit 2; }

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
esac
if [[ $# -ne 2 ]]; then
  usage >&2
  exit 2
fi

number="$1"
slug="$2"

# Validate input before touching anything: cheap checks first, git second.
[[ "$number" =~ ^[0-9]+$ ]] || usage_error "NUMBER must be digits: $number"
[[ "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || usage_error "SLUG must be lowercase-kebab: $slug"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git repository"
[[ -z "$(git status --porcelain)" ]] || die "commit or stash your changes first"

branch="exercise/$number-$slug"
if git show-ref --verify --quiet "refs/heads/$branch"; then
  die "branch $branch already exists"
fi

base="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
base="${base#origin/}"
base="${base:-main}"

git switch --quiet -c "$branch" "$base"
echo "switched to $branch"
