#!/usr/bin/env bash
# pr-ready — REFERENCE SOLUTION to exercise 3.
# Run the same checks as CI, in order, stopping at the first failure.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: pr-ready [--skip-format]

Run format, build and test the way CI does, before you push.

  --skip-format   skip the formatting check
  -h, --help      show this help
EOF
}

skip_format=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-format) skip_format=true ;;
    -h | --help) usage; exit 0 ;;
    *) echo "pr-ready: unknown option '$1'" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

command -v dotnet >/dev/null || { echo "pr-ready: dotnet not found on PATH" >&2; exit 1; }

# step NAME COMMAND... — run one check and report it.
# Running the command inside `if` means a failure is handled here instead of
# `set -e` silently ending the script before we can print what failed.
step() {
  local name="$1"
  shift
  if "$@"; then
    echo "✔ $name"
  else
    echo "✘ $name"
    echo "pr-ready: $name failed" >&2
    exit 1
  fi
}

"$skip_format" || step format dotnet format --verify-no-changes
step build dotnet build --nologo
step test dotnet test --nologo --no-build

echo "ready to push"
